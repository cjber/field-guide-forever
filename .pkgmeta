package-as: FieldGuideForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - .agents
  - .editorconfig
  - .github
  - .gitattributes
  - .gitignore
  - .luacheckrc
  - .luarc.json
  - .styluaignore
  - .sloppatrol
  - AGENTS.md
  - CHANGELOG.md
  - docs
  - media/icon.svg
  - media/icon-400.png
  - reference
  - ruff.toml
  - stylua.toml
  - tests
  - tools
  - types

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - questiedb
  - questie
